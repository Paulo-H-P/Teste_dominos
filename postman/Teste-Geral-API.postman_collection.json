{
  "info": {
    "name": "Teste Geral API",
    "description": "Coleção genérica para testes de API (CRUD, auth, health). Use variáveis baseUrl e jwt. Respostas HTML são tratadas sem falhar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.exemplo.com/v1" },
    { "key": "jwt", "value": "" },
    { "key": "idCriado", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health / Root",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 2xx ou 404', function () {",
              "    var c = pm.response.code;",
              "    pm.expect(c === 404 || (c >= 200 && c < 300)).to.be.true;",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && typeof json === 'object') {",
              "    pm.test('Resposta JSON válida', function () { pm.expect(json).to.be.an('object'); });",
              "} else {",
              "    pm.test('Resposta não-JSON (OK)', function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. GET Lista (query params)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Accept-Language", "value": "pt" }
        ],
        "url": {
          "raw": "{{baseUrl}}/recurso?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["recurso"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 404 ou 500', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && typeof json === 'object') {",
              "    pm.test('Resposta é objeto ou array', function () {",
              "        pm.expect(json).to.satisfy(function (v) { return typeof v === 'object'; });",
              "    });",
              "} else {",
              "    pm.test('Resposta não-JSON (OK)', function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. POST Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teste@exemplo.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 400, 401 ou 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 404]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && pm.response.code === 200 && json.data && json.data.jwt) {",
              "    pm.collectionVariables.set('jwt', json.data.jwt);",
              "    pm.test('JWT salvo', function () { pm.expect(json.data.jwt).to.be.a('string'); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. GET Por ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/recurso/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 404 ou 500', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && typeof json === 'object') {",
              "    pm.test('Resposta é objeto', function () { pm.expect(json).to.be.an('object'); });",
              "} else {",
              "    pm.test('Resposta não-JSON (OK)', function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. GET Autenticado (Bearer)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/recurso-protegido"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 ou 401', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. POST Criar (body JSON)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Item teste\",\n  \"ativo\": true\n}"
        },
        "url": "{{baseUrl}}/recurso"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 201, 400, 401, 403 ou 422', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 422]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && (pm.response.code === 200 || pm.response.code === 201) && json.data && json.data.id) {",
              "    pm.collectionVariables.set('idCriado', String(json.data.id));",
              "    pm.test('ID retornado', function () { pm.expect(json.data.id).to.be.ok; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. PUT Atualizar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Item atualizado\",\n  \"ativo\": false\n}"
        },
        "url": "{{baseUrl}}/recurso/{{idCriado}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 400, 401, 403, 404 ou 422', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403, 404, 422]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (!json) {",
              "    pm.test('Resposta não-JSON (OK)', function () { pm.expect(true).to.be.true; });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. DELETE",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
        "url": "{{baseUrl}}/recurso/{{idCriado}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200, 204, 401, 403 ou 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204, 401, 403, 404]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
