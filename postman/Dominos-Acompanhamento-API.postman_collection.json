{
  "info": {
    "name": "Domino's Acompanhamento API",
    "description": "Coleção para testes de API do projeto Domino's Acompanhamento. Use variáveis baseUrl e jwt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.exemplo.com/v1" },
    { "key": "jwt", "value": "" }
  ],
  "item": [
    {
      "name": "GET Recurso",
      "request": {
        "description": "O que faz: GET /recurso?lingua=pt. Retorno: 200 ou 500; se JSON, valida propriedade status.",
        "method": "GET",
        "header": [
          { "key": "Accept-Language", "value": "pt" }
        ],
        "url": {
          "raw": "{{baseUrl}}/recurso?lingua=pt",
          "host": ["{{baseUrl}}"],
          "path": ["recurso"],
          "query": [
            { "key": "lingua", "value": "pt" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 500', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
              "});",
              "if (pm.response.code === 200) {",
              "    var json = null;",
              "    try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "    if (json && typeof json === 'object') {",
              "        pm.test('Response has status property', function () {",
              "            pm.expect(json).to.have.property('status');",
              "        });",
              "    } else {",
              "        pm.test('Response is non-JSON (e.g. HTML) - OK', function () {",
              "            pm.expect(true).to.be.true;",
              "        });",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST Login",
      "request": {
        "description": "O que faz: POST /login com email e senha. Retorno: 200 (com data.jwt), 400, 401 ou 404. Se 200 e JWT, salva na variavel jwt.",
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teste@exemplo.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200, 400, 401 or 404', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 404]);",
              "});",
              "var json = null;",
              "try { json = JSON.parse(pm.response.text()); } catch (e) { }",
              "if (json && pm.response.code === 200 && json.data && json.data.jwt) {",
              "    pm.collectionVariables.set('jwt', json.data.jwt);",
              "    pm.test('JWT salvo na variável jwt', function () {",
              "        pm.expect(json.data.jwt).to.be.a('string');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET Autenticado (Bearer JWT)",
      "request": {
        "description": "O que faz: GET recurso protegido com Authorization Bearer jwt. Retorno: 200 (autorizado) ou 401 (nao autorizado).",
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Accept-Language", "value": "pt" }
        ],
        "url": "{{baseUrl}}/recurso-protegido"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 401', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
