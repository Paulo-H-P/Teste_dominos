{
  "name": "dominos_acompanhamento",
  "version": "1.0.0",
  "description": "Projeto de acompanhamento Domino's",
  "main": "index.js",
  "scripts": {
    "test:api:postman": "newman run postman/Dominos-Acompanhamento-API.postman_collection.json",
    "test:api:geral": "newman run postman/Teste-Geral-API.postman_collection.json",
    "test:api:ci": "newman run postman/Teste-Geral-API.postman_collection.json --reporters cli,json,htmlextra --reporter-json-export newman-run-report.json --reporter-htmlextra-export newman-report/newman-report.html --reporter-htmlextra-darkTheme && node scripts/newman-to-qase.js",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --browser chrome --headless",
    "cypress:run:qase": "cross-env QASE_MODE=testops cypress run --browser chrome --headless",
    "test:e2e": "npm run cypress:run",
    "test:qase": "npm run cypress:run:qase",
    "allure:generate": "npx allure-commandline generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "cypress run && npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "allure-commandline": "^2.36.0",
    "allure-cypress": "^3.4.5",
    "cross-env": "^10.1.0",
    "cypress": "^13.17.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-qase-reporter": "^3.1.2",
    "dotenv": "^17.2.3",
    "newman": "^6.2.0",
    "newman-reporter-htmlextra": "^1.23.1",
    "rimraf": "^6.1.2"
  }
}
